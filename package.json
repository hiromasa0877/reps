{
  "name": "reps",
  "version": "1.0.0",
  "description": "Mobile-first workout tracker on Cloudflare",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply reps-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply reps-db --local",
    "typecheck": "tsc",
    "types": "wrangler types"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  },
